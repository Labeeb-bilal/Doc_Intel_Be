DATABASE_URL=postgresql+asyncpg://docintel:docintel_dev_only_change_me@localhost:5433/docintel
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=doc_chunks
QDRANT_API_KEY=

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

MAX_FILE_SIZE_MB=25
MAX_FILES_PER_UPLOAD=10
MAX_CHUNKS_PER_DOCUMENT=3000
CHUNK_TARGET_CHARS=1400
CHUNK_MAX_CHARS=1800
CHUNK_OVERLAP_CHARS=200

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
LLM_MAX_CONCURRENCY=4
LLM_RPM=50
LLM_TIMEOUT_SECONDS=60

RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

TOP_K=20
KEEP_N=6
RELEVANCE_FLOOR=0.15
NEIGHBOUR_EXPANSION=true
MAX_CONTEXT_TOKENS=6000

CONTRADICTION_ENABLED=true
CONTRADICTION_SIM_MIN=0.75
CONTRADICTION_SIM_MAX=0.97
CONTRADICTION_MAX_PAIRS=8
CONTRADICTION_MIN_CONFIDENCE=0.6
CONTRADICTION_LLM_BATCH_SIZE=8
CONTRADICTION_MAX_RESPONSE=5
