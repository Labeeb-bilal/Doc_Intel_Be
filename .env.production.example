# Deployment env vars — for Render (or any other host running the
# Dockerfile), NOT for local dev (see .env.example for that).
#
# This is deliberately short: only values that actually differ between
# local dev and a real deployment are listed here. Everything else
# (chunking sizes, contradiction thresholds, rerank model, ...) already
# has a sensible default baked into app/config.py and doesn't need to be
# repeated — set it here too only if you actually want to override it.
#
# How to use: copy this file, fill in the real values (Neon URL, Qdrant
# Cloud URL + key, Groq key), then paste the filled-in block into Render's
# "Environment Variables" tab — most hosts (Render included) accept a
# raw .env-shaped paste there, not just one field at a time.
#
# Never commit the filled-in version — only this placeholder template is
# meant to be in git.

# --- Postgres (Neon or similar managed provider) ----------------------------
# Neon's own dashboard shows you "?sslmode=require" — change that to
# "?ssl=require" before pasting. asyncpg (this app's driver) doesn't
# accept a "sslmode" kwarg at all and fails before it even attempts to
# connect; "ssl" is the parameter it actually understands. Verified
# directly against the installed driver, not assumed — see README.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<neon-host>/<dbname>?ssl=require

# --- Qdrant Cloud -------------------------------------------------------------
# Paste the URL exactly as Qdrant Cloud gives it (https://..., with or
# without an explicit port — both work, verified directly against
# qdrant-client's own URL parsing). QDRANT_COLLECTION only needs to
# change from the dev default if this same Qdrant Cloud cluster will also
# be used for local dev at some point (keeps the two from colliding).
QDRANT_URL=https://<your-cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_API_KEY=<your-qdrant-cloud-api-key>
QDRANT_COLLECTION=doc_chunks

# --- LLM ------------------------------------------------------------------
GROQ_API_KEY=<your-groq-api-key>

# --- Storage ------------------------------------------------------------------
# STORAGE_LOCAL_PATH=/storage matches the Dockerfile's own default, so
# this line is only here as a reminder, not something you need to set
# explicitly. IMPORTANT: local storage only survives restarts if the host
# gives you a persistent disk mounted at that path — Render's persistent
# disks are a paid-plan feature, not available on their free tier. If
# you're on the free tier (or any host with no persistent volume),
# uploaded files are lost on every redeploy/restart unless you switch to
# STORAGE_BACKEND=s3 (+ the S3_* vars) instead.
# STORAGE_BACKEND=local
# STORAGE_LOCAL_PATH=/storage

# --- CORS -----------------------------------------------------------------
# Must list the deployed frontend's real origin(s), not localhost — comma
# separated, no spaces, no trailing slash. Update this once the frontend
# has a real URL.
CORS_ORIGINS=https://<your-frontend-domain>
